# Copy to .env and fill in. .env is gitignored and must never be committed.
# Testnet tUSDC + STT come from the SomniaHacks dev group, faucet topic:
# https://t.me/+XHq0F0JXMyhmMzM0

# A funded Shannon testnet key (chain 50312). Server side only, never exposed to
# the browser, never prefixed NEXT_PUBLIC.
PRIVATE_KEY=0x

# Filled in by scripts/deploy.sh after the router is on chain.
KIOSK_ROUTER=
NEXT_PUBLIC_KIOSK_ROUTER=

# Shannon testnet collateral (tUSDC). Read from the SDK's SOMNIA_TESTNET_ADDRESSES.
COLLATERAL=

# Optional overrides.
RPC_URL=
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Which registered integrator the verification script routes through.
KIOSK_CODE=kiosk-demo
